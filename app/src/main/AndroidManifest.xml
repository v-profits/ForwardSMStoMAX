<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Разрешения -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/> <!--получать сообщения-->
    <uses-permission android:name="android.permission.READ_SMS"/> <!--читать сообщения-->
    <uses-permission android:name="android.permission.READ_CONTACTS" /> <!--доступ к контактам-->

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/> <!--игнор оптимизации батареи для работы в фоновом режиме-->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" /> <!--запускать foreground-сервисы, отображают уведомление в строке состояния-->

    <!-- доступ к информации о SIM-картах -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/max_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ForwardSMStoMAX.NoActionBar"
        tools:targetApi="31">


        <!-- сервис для работы в фоне -->
        <service
            android:name=".ForegroundService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- SMSReceiver: Перехват SMS -->
        <receiver
            android:name=".SMSReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ForwardSMStoMAX.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>